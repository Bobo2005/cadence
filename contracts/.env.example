# ==============================================================================
# Cadence Foundry / Smart Contracts Environment Configuration
# Copy this file to .env: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Multi-Chain Network & Deployer Credentials
# ------------------------------------------------------------------------------
# Ethereum Sepolia (L1 Reference)
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Arbitrum Sepolia (Nitro L2 Rollup - Stylus & Aave v3 Live)
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# Robinhood Chain Testnet (Arbitrum Orbit L2 - Paxos USDG Native)
ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com

# Deployer wallet private key (hex string, with or without 0x prefix)
PRIVATE_KEY=

# Block Explorer API Keys for automated contract verification
ETHERSCAN_API_KEY=
ARBISCAN_API_KEY=

# ------------------------------------------------------------------------------
# 2. Pimlico ERC-4337 Paymaster (Testing & Sponsorship)
# ------------------------------------------------------------------------------
# Pimlico API Key for verifying paymaster policy integration
PIMLICO_API_KEY=

# ------------------------------------------------------------------------------
# 3. Accelerated Demo Vault Deployment Parameters (DeployDemoVault.s.sol)
# ------------------------------------------------------------------------------
# Short heartbeat interval in seconds (default: 180 = 3 minutes)
DEMO_CHECK_IN_INTERVAL=180

# Contest challenge window in seconds (default: 900 = 15 minutes)
DEMO_CONTEST_DURATION=900

# Initial ETH deposited into the vault at deployment (in wei; default: 0.05 ETH)
DEMO_DEPOSIT_WEI=50000000000000000

# Optional: reuse existing core infrastructure if already deployed on Sepolia
# CONSENSUS_ADDRESS=
# GUARDIAN_REGISTRY_ADDRESS=
