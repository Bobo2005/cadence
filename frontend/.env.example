# ==============================================================================
# Cadence Frontend Environment Variables
# Copy this file to .env.local: cp .env.example .env.local
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RPC & Network Configuration (Ethereum Sepolia Testnet)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CHAIN_ID=11155111
NEXT_PUBLIC_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# ------------------------------------------------------------------------------
# 2. Deployed Smart Contract Addresses (from Deploy.s.sol or DeployDemoVault.s.sol)
# ------------------------------------------------------------------------------
# Main deployed inheritance vault address (or demo vault address)
NEXT_PUBLIC_VAULT_ADDRESS=

# Protocol Core Infrastructure
NEXT_PUBLIC_CONSENSUS_ADDRESS=
NEXT_PUBLIC_GUARDIAN_REGISTRY_ADDRESS=
NEXT_PUBLIC_STEALTH_REGISTRY_ADDRESS=
NEXT_PUBLIC_FACTORY_ADDRESS=

# ------------------------------------------------------------------------------
# 3. Pimlico ERC-4337 Verifying Paymaster (Gasless Check-Ins)
# ------------------------------------------------------------------------------
# NOTE: This is a public/publishable client key intentionally exposed in frontend code
# for client-side paymaster sponsorship requests (https://dashboard.pimlico.io).
# Never place server-only secret credentials in NEXT_PUBLIC_ variables.
# If left blank, the frontend gracefully falls back to direct wallet transactions.
NEXT_PUBLIC_PIMLICO_API_KEY=

# ------------------------------------------------------------------------------
# 4. Notification Backend Service (Local or Production Daemon)
# ------------------------------------------------------------------------------
# URL of the running /notifications microservice (defaults to http://localhost:3001)
NEXT_PUBLIC_NOTIFICATION_URL=http://localhost:3001
