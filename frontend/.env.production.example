# ==============================================================================
# Cadence Frontend Production Environment Variables (Vercel Deployment)
# Copy these values into your Vercel Project Settings > Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RPC & Network Configuration (Ethereum Sepolia Testnet)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CHAIN_ID=11155111
NEXT_PUBLIC_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# ------------------------------------------------------------------------------
# 2. Deployed Sepolia Smart Contract Addresses
# ------------------------------------------------------------------------------
# Standard 90-Day Production Vault Instance
NEXT_PUBLIC_VAULT_ADDRESS=0x043d02c39B86CAd83E1Bf05728D32d24f6289e74

# Accelerated 3-Minute / 5-Minute Demo Vault for Judges
NEXT_PUBLIC_DEMO_VAULT_ADDRESS=0x6a555565CAef70d28c8eC038D5Af8475fE5C97b1

# Protocol Core Infrastructure
NEXT_PUBLIC_CONSENSUS_ADDRESS=0x781986427A17432E2d7B4B2C8a36E51a43fe6Bc1
NEXT_PUBLIC_DEMO_CONSENSUS_ADDRESS=0xebbC0241acb9AE8F52836C3BB4499152c4b5EbAf

NEXT_PUBLIC_GUARDIAN_REGISTRY_ADDRESS=0xcFD059B73ca3E2d329Ed7A7A899374968C3d4863
NEXT_PUBLIC_DEMO_GUARDIAN_REGISTRY_ADDRESS=0xac0f91C7d7c3537896248C42fc880F6DFF838622

NEXT_PUBLIC_STEALTH_REGISTRY_ADDRESS=0x583eC2de840034478a61EF572cea2904bFD8671E
NEXT_PUBLIC_BALANCE_COMMITMENT_ADDRESS=0x1AeAd0c358f067E6607BAc64CD3A2581547eA1BC
NEXT_PUBLIC_FACTORY_ADDRESS=0x30489c0f3566AF47b71867bc992408B91E500823
NEXT_PUBLIC_VAULT_FACTORY_ADDRESS=0x9fE46736679d2D9a65F0992F2272dE9f3c7fa6e0

# ------------------------------------------------------------------------------
# 3. Pimlico ERC-4337 Verifying Paymaster (Gasless Check-Ins)
# ------------------------------------------------------------------------------
# NOTE: This is a public/publishable client key intentionally exposed in frontend code
# for client-side paymaster sponsorship requests.
NEXT_PUBLIC_PIMLICO_API_KEY=

# ------------------------------------------------------------------------------
# 4. Notification Backend Service URL (Render Web Service)
# ------------------------------------------------------------------------------
# Replace with your deployed Render URL: e.g. https://cadence-notifications.onrender.com
NEXT_PUBLIC_NOTIFICATION_URL=https://cadence-notifications.onrender.com
