# ==============================================================================
# Cadence Notifications Backend Environment Configuration
# ==============================================================================

PORT=3001
NODE_ENV=development

# Allowed Frontend Client Origin for strict CORS
CLIENT_URL=https://cadence-ebon-six.vercel.app

# Security & Access Control Keys
ADMIN_API_KEY=cadence-admin-secret-replace-in-production
CADENCE_INTERNAL_API_KEY=cadence-internal-secret-replace-in-production

# Sepolia RPC URL (used for resolving signature verification and chain state)
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# ==============================================================================
# Live Email Delivery Options (Optional - Defaults to local data/outbox.json)
# ==============================================================================

# OPTION 1: Resend (Recommended: free tier 3,000 emails/month, instant setup at resend.com)
# RESEND_API_KEY=re_your_api_key_here
# SMTP_FROM="Cadence Protocol <onboarding@resend.dev>"

# OPTION 2: Gmail App Password / Custom SMTP
# 1. Enable 2-Factor Auth on your Google Account
# 2. Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
# 3. Fill in your details below and uncomment:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_16_digit_app_password
# SMTP_FROM="Cadence Protocol <your_email@gmail.com>"
